{
  "manifest_version": 3,
  "name": "2Secret",
  "short_name": "2Secret",
  "version": "1.1.0",
  "description": "Free, open-source password manager. Fill logins and one-time codes from your end-to-end encrypted 2Secret vault.",
  "homepage_url": "https://github.com/joostiphone/2Secret",
  "action": {
    "default_title": "2Secret",
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "64": "icons/icon-64.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "64": "icons/icon-64.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab", "scripting", "storage", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+L", "mac": "Command+Shift+L" },
      "description": "Open 2Secret"
    }
  },
  "browser_specific_settings": {
    "gecko": { "id": "2secret@joostiphone.github.io", "strict_min_version": "121.0" }
  }
}
