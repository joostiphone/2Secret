<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  The application manifest of 2-secret.exe (Dioxus.toml: [bundle.windows]
  extra_rc). The msix element connects the program to its identity package
  (windows/identity/AppxManifest.xml): with that package registered for this
  folder, 2Secret runs with package identity, which Windows needs from a
  passkey provider. Without it, Windows ignores the element.
  publisher, packageName and applicationId must equal Publisher, Name and
  Application Id there.
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="io.github.joostiphone.twosecret" type="win32" />
  <msix xmlns="urn:schemas-microsoft-com:msix.v1"
        publisher="CN=2Secret"
        packageName="io.github.joostiphone.twosecret"
        applicationId="TwoSecret" />
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
