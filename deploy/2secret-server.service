# systemd unit for 2secret-server.
#   sudo useradd --system --home /var/lib/2secret 2secret
#   sudo cp 2secret-server /usr/local/bin/ && sudo cp 2secret-server.service /etc/systemd/system/
#   sudo systemctl enable --now 2secret-server
[Unit]
Description=2Secret sync server
After=network-online.target
Wants=network-online.target

[Service]
User=2secret
Environment=TWOSECRET_BIND=127.0.0.1:8743
Environment=TWOSECRET_DATA_DIR=/var/lib/2secret
Environment=TWOSECRET_WEB_DIR=/usr/local/share/2secret/web
Environment=TWOSECRET_SIGNUPS=invite
Environment=TWOSECRET_INVITE_CODES=change-me
ExecStart=/usr/local/bin/2secret-server
Restart=on-failure
StateDirectory=2secret
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/2secret

[Install]
WantedBy=multi-user.target
