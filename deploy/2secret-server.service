# systemd unit for 2secret-server.
#   sudo useradd --system --home /var/lib/2secret 2secret
#   sudo cp 2secret-server /usr/local/bin/ && sudo cp 2secret-server.service /etc/systemd/system/
#   sudo systemctl enable --now 2secret-server
[Unit]
Description=2Secret sync server
After=network-online.target
Wants=network-online.target

[Service]
User=2secret
Environment=TWOSECRET_BIND=127.0.0.1:8743
Environment=TWOSECRET_DATA_DIR=/var/lib/2secret
Environment=TWOSECRET_WEB_DIR=/usr/local/share/2secret/web
Environment=TWOSECRET_SIGNUPS=invite
Environment=TWOSECRET_INVITE_CODES=change-me
# The client's address from the reverse proxy on this machine (Caddy, nginx;
# docs/SELF-HOSTING.md). Believed only from this machine.
Environment=TWOSECRET_CLIENT_IP_HEADER=X-Forwarded-For
ExecStart=/usr/local/bin/2secret-server
Restart=on-failure
StateDirectory=2secret
# The server listens on a port above 1024 and writes only to its data
# directory: it needs no capabilities, devices or kernel settings.
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/lib/2secret
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
